<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Forge.Extensions</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Forge.Debug\Forge.Debug.csproj" />
		<ProjectReference Include="..\Forge.Language\Forge.Language.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Forge.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
		<PackageReference Include="Microsoft.Diagnostics.Runtime" />
		<PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Dotnet\package.json" CopyToOutputDirectory="PreserveNewest" Link="Extensions\Dotnet\package.json" />
		<None Include="Discord\package.json" CopyToOutputDirectory="PreserveNewest" Link="Extensions\Discord\package.json" />
		<None Include="TrailingSpaces\package.json" CopyToOutputDirectory="PreserveNewest" Link="Extensions\TrailingSpaces\package.json" />
		<None Include="MergeConflict\package.json" CopyToOutputDirectory="PreserveNewest" Link="Extensions\MergeConflict\package.json" />
		<None Include="IndentRainbow\package.json" CopyToOutputDirectory="PreserveNewest" Link="Extensions\IndentRainbow\package.json" />
		<None Include="DotnetProfiler\package.json" CopyToOutputDirectory="PreserveNewest" Link="Extensions\DotnetProfiler\package.json" />
		<None Include="Discord\discord-languages.json" CopyToOutputDirectory="PreserveNewest" Link="Extensions\Discord\discord-languages.json" />
	</ItemGroup>

	<PropertyGroup>
		<NetCoreDbgRoot>$(MSBuildThisFileDirectory)..\native\netcoredbg\</NetCoreDbgRoot>
		<NetCoreDbgBin>$(NetCoreDbgRoot)bin\</NetCoreDbgBin>
	</PropertyGroup>

	<ItemGroup>
		<NetCoreDbgSource Include="$(NetCoreDbgRoot)src\**\*.cpp;$(NetCoreDbgRoot)src\**\*.h;$(NetCoreDbgRoot)src\**\*.cs;$(NetCoreDbgRoot)**\CMakeLists.txt" Exclude="$(NetCoreDbgRoot).coreclr\**;$(NetCoreDbgRoot)build\**" />
	</ItemGroup>

	<Target Name="BuildNetCoreDbg" BeforeTargets="BeforeBuild" Condition="Exists('$(NetCoreDbgRoot)CMakeLists.txt')" Inputs="@(NetCoreDbgSource)" Outputs="$(NetCoreDbgBin)netcoredbg.exe">
		<Message Importance="high" Text="Building netcoredbg fork..." />
		<Exec Condition="!Exists('$(NetCoreDbgRoot)build\CMakeCache.txt')" Command="cmake -S &quot;$(NetCoreDbgRoot.TrimEnd('\'))&quot; -B &quot;$(NetCoreDbgRoot)build&quot; -G &quot;Visual Studio 17 2022&quot; -A x64 -DCMAKE_INSTALL_PREFIX=&quot;$(NetCoreDbgBin.TrimEnd('\'))&quot;" />
		<Exec Command="cmake --build &quot;$(NetCoreDbgRoot)build&quot; --config Release --target install -- -m -v:m" />
		<Touch Files="$(NetCoreDbgBin)netcoredbg.exe" />
	</Target>

	<Target Name="CopyNetCoreDbg" AfterTargets="BuildNetCoreDbg" BeforeTargets="AssignTargetPaths">
		<ItemGroup>
			<NetCoreDbgFile Include="$(NetCoreDbgBin)**\*" />
			<None Include="@(NetCoreDbgFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Debugger\netcoredbg\%(NetCoreDbgFile.RecursiveDir)%(NetCoreDbgFile.Filename)%(NetCoreDbgFile.Extension)" Visible="false" />
		</ItemGroup>
	</Target>

	<PropertyGroup>
		<RoslynRoot>$(MSBuildThisFileDirectory)..\native\roslyn\</RoslynRoot>
		<RoslynServerProject>$(RoslynRoot)src\LanguageServer\Microsoft.CodeAnalysis.LanguageServer\Microsoft.CodeAnalysis.LanguageServer.csproj</RoslynServerProject>
		<RoslynBin>$(RoslynRoot)bin\</RoslynBin>
	</PropertyGroup>

	<ItemGroup>
		<RoslynSource Include="$(RoslynRoot)src\LanguageServer\**\*.cs;$(RoslynRoot)src\Workspaces\**\*.cs;$(RoslynRoot)src\Features\**\*.cs;$(RoslynRoot)src\Compilers\Core\**\*.cs;$(RoslynRoot)src\Compilers\CSharp\Portable\**\*.cs;$(RoslynRoot)eng\targets\*.props;$(RoslynRoot)eng\targets\*.targets;$(RoslynRoot)*.props;$(RoslynRoot)*.targets;$(RoslynRoot)global.json;$(RoslynRoot)src\LanguageServer\**\*.csproj" Exclude="$(RoslynRoot)**\obj\**;$(RoslynRoot)**\bin\**;$(RoslynRoot)**\*Test*\**" />
	</ItemGroup>

	<Target Name="BuildRoslynServer" BeforeTargets="BeforeBuild" Condition="Exists('$(RoslynServerProject)')" Inputs="@(RoslynSource)" Outputs="$(RoslynBin)Microsoft.CodeAnalysis.LanguageServer.dll">
		<Message Importance="high" Text="Building roslyn language server fork..." />
		<Exec WorkingDirectory="$(RoslynRoot)" Command="dotnet publish &quot;$(RoslynServerProject)&quot; -c Release -o &quot;$(RoslynBin.TrimEnd('\'))&quot; -v:m -m -p:RunAnalyzers=false -p:TreatWarningsAsErrors=false -p:UsingToolXliff=false -p:EnableNgenOptimization=false -p:SatelliteResourceLanguages=en" />
		<Touch Files="$(RoslynBin)Microsoft.CodeAnalysis.LanguageServer.dll" />
	</Target>

	<Target Name="CopyRoslynServer" AfterTargets="BuildRoslynServer" BeforeTargets="AssignTargetPaths">
		<ItemGroup>
			<RoslynFile Include="$(RoslynBin)**\*" />
			<None Include="@(RoslynFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="LanguageServer\roslyn\%(RoslynFile.RecursiveDir)%(RoslynFile.Filename)%(RoslynFile.Extension)" Visible="false" />
		</ItemGroup>
	</Target>
</Project>

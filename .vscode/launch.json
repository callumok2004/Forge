{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Forge",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/artifacts/bin/Forge.App/x64/Debug/net10.0-windows10.0.19041.0/Forge.exe",
			"args": [],
			"cwd": "${workspaceFolder}",
			"console": "externalTerminal",
			"stopAtEntry": false
		},
		{
			"name": "Forge (open folder)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/artifacts/bin/Forge.App/x64/Debug/net10.0-windows10.0.19041.0/Forge.exe",
			"args": [
				"${input:openFolder}"
			],
			"cwd": "${workspaceFolder}",
			"console": "externalTerminal",
			"stopAtEntry": false
		},
		{
			"name": "Attach",
			"type": "coreclr",
			"request": "attach"
		}
	],
	"inputs": [
		{
			"id": "openFolder",
			"type": "promptString",
			"description": "Folder for Forge to open on launch",
			"default": "${workspaceFolder}"
		}
	]
}

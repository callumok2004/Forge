<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<RootNamespace>Forge.App</RootNamespace>
		<AssemblyName>Forge</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon Condition="'$(ForgeDev)'!='true'">Assets\forge.ico</ApplicationIcon>
		<ApplicationIcon Condition="'$(ForgeDev)'=='true'">Assets\forge-dev.ico</ApplicationIcon>
	</PropertyGroup>

	<PropertyGroup Condition="'$(PublishAot)'!='true'">
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>

	<PropertyGroup Condition="'$(PublishAot)'=='true'">
		<StackTraceSupport>false</StackTraceSupport>
		<IlcOptimizationPreference>Speed</IlcOptimizationPreference>
		<IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Forge.Shell\Forge.Shell.csproj" />
	</ItemGroup>
</Project>
